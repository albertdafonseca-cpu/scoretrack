{
  "name": "scoretrack",
  "version": "2.0.0",
  "private": true,
  "description": "ScoreTrack — compteur de scores universel (PWA statique, sans dépendance à l'exécution)",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "http-server -p 8765 -s .",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "npm run test:unit",
    "build:sw": "node scripts/build-sw.mjs",
    "check:sw": "node scripts/build-sw.mjs --check",
    "check": "npm run lint && npm run check:sw && npm run test:unit && npm run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.56.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "http-server": "^14.1.1",
    "prettier": "^3.9.7",
    "vitest": "^5.0.1"
  }
}
