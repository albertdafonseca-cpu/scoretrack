{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "GATEGUARD_BASH_ROUTINE_DISABLED": "1",
    "GATEGUARD_EXEMPT_GLOBS": "**/tests/**,**/*.test.*,**/*.essai.*",
    "GATEGUARD_FACT_FORCE_FULL_DENIALS": "0"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|MultiEdit|Write|NotebookEdit|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/fichiers-sensibles.mjs\""
          }
        ]
      }
    ]
  }
}
