# https://editorconfig.org — cohérent avec .prettierrc (2 espaces, LF, UTF-8, 100 colonnes)
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 100

[*.md]
trim_trailing_whitespace = false

[*.{woff2,png,svg,ico}]
insert_final_newline = false
