{
  "ci": {
    "collect": {
      "startServerCommand": "npx http-server -p 8799 -c-1 .",
      "startServerReadyPattern": "Available on",
      "startServerReadyTimeout": 30000,
      "url": ["http://localhost:8799/"],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --disable-dev-shm-usage",
        "skipAudits": ["is-on-https", "redirects-http", "uses-http2", "uses-text-compression"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          { "minScore": 0.95, "aggregationMethod": "median-run" }
        ],
        "categories:accessibility": [
          "error",
          { "minScore": 0.86, "aggregationMethod": "median-run" }
        ],
        "categories:best-practices": [
          "error",
          { "minScore": 0.95, "aggregationMethod": "median-run" }
        ],
        "categories:seo": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }],

        "meta-viewport": "off",

        "aria-allowed-attr": ["error", { "minScore": 1 }],
        "aria-hidden-body": ["error", { "minScore": 1 }],
        "aria-hidden-focus": ["error", { "minScore": 1 }],
        "aria-required-attr": ["error", { "minScore": 1 }],
        "aria-roles": ["error", { "minScore": 1 }],
        "aria-valid-attr": ["error", { "minScore": 1 }],
        "aria-valid-attr-value": ["error", { "minScore": 1 }],
        "button-name": ["error", { "minScore": 1 }],
        "color-contrast": ["error", { "minScore": 1 }],
        "document-title": ["error", { "minScore": 1 }],
        "duplicate-id-aria": ["error", { "minScore": 1 }],
        "html-has-lang": ["error", { "minScore": 1 }],
        "html-lang-valid": ["error", { "minScore": 1 }],
        "image-alt": ["error", { "minScore": 1 }],
        "label": ["error", { "minScore": 1 }],
        "link-name": ["error", { "minScore": 1 }],
        "list": ["error", { "minScore": 1 }],
        "listitem": ["error", { "minScore": 1 }],
        "target-size": ["error", { "minScore": 1 }],

        "font-size": ["error", { "minScore": 1 }],
        "errors-in-console": ["error", { "minScore": 1 }],
        "cumulative-layout-shift": [
          "error",
          { "maxNumericValue": 0.1, "aggregationMethod": "median-run" }
        ],
        "total-byte-weight": ["error", { "maxNumericValue": 512000 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
